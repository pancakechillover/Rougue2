{
  "name": "scholars-dungeon",
  "description": "A Roguelike-themed study system with Pomodoro timers, talent trees, and meta-progression rewards.",
  "private": true,
  "version": "9.7.5",
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate-version.ts",
    "dev": "tsx server.ts",
    "build": "tsx scripts/generate-version.ts && vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src api server.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"api/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test"
  },
  "overrides": {
    "node-domexception": "npm:domexception@^4.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^5.11.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "vite": "^6.2.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
